---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Hero from '@/components/sections/Hero.astro';
import Fusion from '@/components/sections/Fusion.astro';
import Pasteleria from '@/components/sections/Pasteleria.astro';
import Flores from '@/components/sections/Flores.astro';
import VisualImpact from '@/components/sections/VisualImpact.astro';
import Experience from '@/components/sections/Experience.astro';
import Products from '@/components/sections/Products.astro';
import Instagram from '@/components/sections/Instagram.astro';
import CTA from '@/components/sections/CTA.astro';
import Contact from '@/components/sections/Contact.astro';
---

<BaseLayout
  title="La Fusió — Pastelería, flores y momentos."
  description="La Fusió es un espacio que fusiona pastelería artesanal y floristería. Un lugar para disfrutar de nuestra pastelería, tomar un café, descubrir flores y quedarte un poco más."
>
  <Header />
  <main id="main">
    <Hero />
    <Fusion />
    <Pasteleria />
    <Flores />
    <VisualImpact />
    <Experience />
    <Products />
    <Instagram />
    <CTA />
    <Contact />
  </main>
  <Footer />
</BaseLayout>
