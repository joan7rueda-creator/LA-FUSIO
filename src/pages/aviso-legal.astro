---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
---

<BaseLayout title="Aviso legal — LAFUSIO" description="Aviso legal de LAFUSIO.">
  <Header />
  <main id="main" class="mx-auto max-w-2xl px-5 py-28 lg:px-8">
    <h1 class="font-display text-4xl font-medium text-ink-800">Aviso legal</h1>
    <p class="mt-6 text-ink-700/80">
      Este contenido está pendiente de redacción legal definitiva. Aquí se detallará la identificación
      del titular del sitio web y las condiciones generales de uso.
    </p>
  </main>
  <Footer />
</BaseLayout>
