---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import { useTranslations, type Lang } from '@/i18n/utils';

export function getStaticPaths() {
  return [{ params: { lang: 'ca' } }, { params: { lang: 'es' } }];
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  path="/cookies/"
  title={t('legal.cookies.metaTitle')}
  description={t('legal.cookies.metaDescription')}
>
  <Header lang={lang} />
  <main id="main" class="mx-auto max-w-2xl px-5 py-28 lg:px-8">
    <h1 class="font-display text-4xl font-medium text-ink-800">{t('legal.cookies.title')}</h1>
    <p class="mt-6 text-ink-700/80">{t('legal.cookies.body')}</p>
  </main>
  <Footer lang={lang} />
</BaseLayout>
