---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Hero from '@/components/sections/Hero.astro';
import Fusion from '@/components/sections/Fusion.astro';
import Pasteleria from '@/components/sections/Pasteleria.astro';
import Flores from '@/components/sections/Flores.astro';
import VisualImpact from '@/components/sections/VisualImpact.astro';
import Experience from '@/components/sections/Experience.astro';
import Products from '@/components/sections/Products.astro';
import Instagram from '@/components/sections/Instagram.astro';
import CTA from '@/components/sections/CTA.astro';
import Contact from '@/components/sections/Contact.astro';
import { useTranslations, type Lang } from '@/i18n/utils';

export function getStaticPaths() {
  return [{ params: { lang: 'ca' } }, { params: { lang: 'es' } }];
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
---

<BaseLayout lang={lang} path="/" title={t('site.title')} description={t('site.description')}>
  <Header lang={lang} />
  <main id="main">
    <Hero lang={lang} />
    <Fusion lang={lang} />
    <Pasteleria lang={lang} />
    <Flores lang={lang} />
    <VisualImpact lang={lang} />
    <Experience lang={lang} />
    <Products lang={lang} />
    <Instagram lang={lang} />
    <CTA lang={lang} />
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
</BaseLayout>
