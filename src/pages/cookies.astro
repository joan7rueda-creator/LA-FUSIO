---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
---

<BaseLayout title="Política de cookies — La Fusió" description="Política de cookies de La Fusió.">
  <Header />
  <main id="main" class="mx-auto max-w-2xl px-5 py-28 lg:px-8">
    <h1 class="font-display text-4xl font-medium text-ink-800">Política de cookies</h1>
    <p class="mt-6 text-ink-700/80">
      Este contenido está pendiente de redacción legal definitiva. Aquí se detallarán las cookies utilizadas
      en este sitio web y cómo gestionarlas.
    </p>
  </main>
  <Footer />
</BaseLayout>
