---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
---

<BaseLayout title="Política de privacidad — LAFUSIO" description="Política de privacidad de LAFUSIO.">
  <Header />
  <main id="main" class="mx-auto max-w-2xl px-5 py-28 lg:px-8">
    <h1 class="font-display text-4xl font-medium text-ink-800">Política de privacidad</h1>
    <p class="mt-6 text-ink-700/80">
      Este contenido está pendiente de redacción legal definitiva. Aquí se detallará cómo LAFUSIO recoge,
      utiliza y protege los datos personales de las personas usuarias de este sitio web.
    </p>
  </main>
  <Footer />
</BaseLayout>
