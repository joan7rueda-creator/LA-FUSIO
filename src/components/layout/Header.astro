---
import Icon from '@/components/ui/Icon.astro';

const links = [
  { href: '#fusion', label: 'La Fusión' },
  { href: '#cafe', label: 'Café' },
  { href: '#flores', label: 'Flores' },
  { href: '#instagram', label: 'Instagram' },
  { href: '#visitanos', label: 'Visítanos' },
];
---

<header
  class="sticky top-0 z-40 border-b border-ink-800/0 bg-sand-100/80 backdrop-blur-md transition-colors duration-500 data-[scrolled=true]:border-ink-800/10 data-[scrolled=true]:bg-sand-100/95"
  data-header
>
  <div class="mx-auto flex max-w-[90rem] items-center justify-between px-5 py-4 lg:px-10">
    <a href="#top" class="flex shrink-0 items-center gap-2">
      <span class="font-display text-xl font-semibold tracking-[0.02em] text-ink-800">
        LA<span class="text-olive-700">FUSIO</span>
      </span>
    </a>

    <nav aria-label="Principal" class="hidden lg:flex lg:items-center lg:gap-9">
      {links.map((link) => (
        <a
          href={link.href}
          class="relative py-1 text-[0.8rem] font-medium uppercase tracking-[0.1em] text-ink-800/75 transition-colors duration-200 after:absolute after:-bottom-0.5 after:left-0 after:h-px after:w-full after:origin-left after:scale-x-0 after:bg-olive-600 after:transition-transform after:duration-300 after:ease-out hover:text-ink-800 hover:after:scale-x-100"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <a
      href="#contacto"
      class="hidden items-center gap-2 rounded-full border border-ink-800/25 px-5 py-2.5 text-[0.75rem] font-semibold uppercase tracking-[0.12em] text-ink-800 transition-colors duration-200 hover:border-ink-800 hover:bg-ink-800 hover:text-sand-50 lg:inline-flex"
    >
      Contacta
    </a>

    <details class="group relative lg:hidden">
      <summary
        class="flex cursor-pointer list-none items-center justify-center rounded-full p-2 text-ink-800 [&::-webkit-details-marker]:hidden"
        aria-label="Abrir menú"
      >
        <Icon name="menu" class="h-6 w-6 group-open:hidden" />
        <Icon name="close" class="hidden h-6 w-6 group-open:block" />
      </summary>

      <nav
        aria-label="Principal"
        class="mobile-menu-panel absolute right-0 top-full mt-3 w-64 rounded-2xl border border-ink-800/10 bg-sand-50 p-5 shadow-xl shadow-ink-900/10"
      >
        <ul class="flex flex-col gap-1">
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                class="block rounded-lg px-3 py-2.5 text-sm font-medium text-ink-800 transition-colors duration-200 hover:bg-olive-50"
              >
                {link.label}
              </a>
            </li>
          ))}
          <li class="mt-2 border-t border-ink-800/10 pt-3">
            <a
              href="#contacto"
              class="block rounded-lg px-3 py-2.5 text-sm font-semibold text-olive-700 transition-colors duration-200 hover:bg-olive-50"
            >
              Contacta
            </a>
          </li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .mobile-menu-panel {
    transition:
      opacity 220ms var(--ease-premium, ease-out),
      transform 220ms var(--ease-premium, ease-out);
    transition-behavior: allow-discrete;
  }

  @starting-style {
    details[open] > .mobile-menu-panel {
      opacity: 0;
      transform: translateY(-8px) scale(0.97);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu-panel {
      transition: none;
    }
  }
</style>

<script>
  // Marca el header como "scrolled" para oscurecer ligeramente su fondo tras el Hero.
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const onScroll = () => {
      header.dataset.scrolled = window.scrollY > 40 ? 'true' : 'false';
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>
