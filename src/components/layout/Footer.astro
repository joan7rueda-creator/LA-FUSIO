---
import { Image } from 'astro:assets';
import { SITE } from '@/data/site';
import Icon from '@/components/ui/Icon.astro';
import { useTranslations, useTranslatedPath, type Lang } from '@/i18n/utils';
import logo from '@/assets/brand/lafusio-logo.png';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const home = useTranslatedPath(lang)('/');
const year = new Date().getFullYear();

const nav = [
  { href: '#fusion', label: t('nav.fusion') },
  { href: '#pasteleria', label: t('nav.pasteleria') },
  { href: '#flores', label: t('nav.flores') },
  { href: '#productos', label: t('products.title') },
];

const legal = [
  { href: useTranslatedPath(lang)('/privacidad/'), label: t('footer.legal.privacy') },
  { href: useTranslatedPath(lang)('/cookies/'), label: t('footer.legal.cookies') },
  { href: useTranslatedPath(lang)('/aviso-legal/'), label: t('footer.legal.avisoLegal') },
];
---

<footer class="border-t border-sand-50/10 bg-ink-800 text-sand-100">
  <div class="mx-auto grid max-w-[90rem] gap-12 px-5 py-16 sm:grid-cols-2 lg:grid-cols-5 lg:px-10 lg:py-20">
    <div class="sm:col-span-2 lg:col-span-2">
      <a href={home} class="inline-flex">
        <Image
          src={logo}
          alt="La Fusió — Sant Celoni"
          width={112}
          height={112}
          class="h-14 w-14 rounded-full ring-1 ring-sand-50/15"
        />
      </a>
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-sand-100/65">
        {t('footer.tagline')}
      </p>
      <a
        href={SITE.social.instagram}
        target="_blank"
        rel="noopener noreferrer me"
        class="mt-6 inline-flex items-center gap-2 rounded-full border border-sand-50/15 px-4 py-2 text-sm font-medium transition-colors hover:border-clay-400 hover:text-clay-300"
      >
        <Icon name="instagram" class="h-4 w-4" />
        {SITE.social.instagramHandle}
      </a>
    </div>

    <div>
      <h2 class="text-xs font-semibold uppercase tracking-[0.14em] text-sand-50/90">{t('footer.nav.title')}</h2>
      <ul class="mt-4 space-y-2.5 text-sm text-sand-100/65">
        {nav.map((item) => (
          <li><a href={item.href} class="transition-colors duration-200 hover:text-clay-300">{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="text-xs font-semibold uppercase tracking-[0.14em] text-sand-50/90">{t('footer.contact.title')}</h2>
      <ul class="mt-4 space-y-2.5 text-sm text-sand-100/65">
        <li>{t('contact.placeholderAddress')}</li>
        <li>{t('contact.placeholderPhone')}</li>
        <li>
          <a href={`mailto:${SITE.contact.email}`} class="break-all transition-colors duration-200 hover:text-clay-300">
            {SITE.contact.email}
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h2 class="text-xs font-semibold uppercase tracking-[0.14em] text-sand-50/90">{t('footer.hours.title')}</h2>
      <ul class="mt-4 space-y-2.5 text-sm text-sand-100/65">
        {SITE.hours.map((h) => (
          <li class="flex justify-between gap-4">
            <span>{t(`hours.${h.dayKey}` as const)}</span>
            <span class="text-sand-100/45">{t('contact.hours.consultar')}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="border-t border-sand-50/10">
    <div class="mx-auto flex max-w-[90rem] flex-col items-center gap-6 px-5 py-10 text-center lg:px-10">
      <p class="font-display text-2xl font-medium text-sand-50 sm:text-3xl">
        {t('footer.bigline')}
      </p>
    </div>
  </div>

  <div class="border-t border-sand-50/10">
    <div class="mx-auto flex max-w-[90rem] flex-col gap-3 px-5 py-6 text-xs text-sand-100/45 sm:flex-row sm:items-center sm:justify-between lg:px-10">
      <p>&copy; {year} {SITE.name}. {t('footer.legal.rights')}</p>
      <ul class="flex flex-wrap gap-x-5 gap-y-1">
        {legal.map((item) => (
          <li><a href={item.href} class="transition-colors duration-200 hover:text-sand-100">{item.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
</footer>
