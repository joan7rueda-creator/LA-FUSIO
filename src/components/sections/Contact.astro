---
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { SITE, formatRanges } from '@/data/site';
import { useTranslations, type Lang } from '@/i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const info = [
  { icon: 'pin' as const, label: t('contact.info.address'), value: SITE.address.display, href: SITE.maps.directionsUrl },
  { icon: 'phone' as const, label: t('contact.info.phone'), value: SITE.contact.phoneDisplay, href: `tel:${SITE.contact.phone}` },
  { icon: 'mail' as const, label: t('contact.info.email'), value: SITE.contact.email, href: `mailto:${SITE.contact.email}` },
  { icon: 'instagram' as const, label: t('contact.info.instagram'), value: SITE.social.instagramHandle, href: SITE.social.instagram },
];
---

<section id="visitanos" class="relative overflow-hidden bg-sand-50 py-24 sm:py-32 lg:py-36">
  <div class="mx-auto max-w-[90rem] px-5 lg:px-10">
    <div class="max-w-xl">
      <p data-reveal class="text-xs font-semibold uppercase tracking-[0.28em] text-clay-700">
        {t('contact.eyebrow')}
      </p>
      <h2 data-reveal="lg" data-reveal-delay="80" class="mt-5 font-display text-4xl font-medium leading-[1.05] text-ink-800 sm:text-5xl lg:text-6xl">
        {t('contact.title')}
      </h2>
    </div>

    <div id="contacto" class="mt-16 grid gap-10 lg:grid-cols-12 lg:gap-8 lg:mt-20">
      <div data-reveal data-reveal-delay="140" class="lg:col-span-5">
        <dl class="divide-y divide-ink-800/10 border-t border-ink-800/10">
          {info.map((item) => (
            <div class="flex items-center gap-4 py-5">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-clay-50 text-clay-700">
                <Icon name={item.icon} class="h-4.5 w-4.5" />
              </span>
              <div>
                <dt class="text-[0.65rem] font-semibold uppercase tracking-[0.14em] text-ink-700/50">{item.label}</dt>
                <dd class="mt-0.5 text-base text-ink-800">
                  <a href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined} class="transition-colors duration-200 hover:text-clay-700">
                    {item.value}
                  </a>
                </dd>
              </div>
            </div>
          ))}
          <div class="flex items-start gap-4 py-5">
            <span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-clay-50 text-clay-700">
              <Icon name="clock" class="h-4.5 w-4.5" />
            </span>
            <div class="flex-1">
              <dt class="text-[0.65rem] font-semibold uppercase tracking-[0.14em] text-ink-700/50">{t('contact.hours.title')}</dt>
              <dd class="mt-1.5 space-y-1">
                {SITE.hours.map((h) => (
                  <div class="flex justify-between gap-6 text-sm text-ink-800/85">
                    <span>{t(`hours.${h.dayKey}` as const)}</span>
                    <span class="text-right text-ink-700/70">
                      {h.ranges.length > 0 ? formatRanges(h.ranges) : t('hours.closed')}
                    </span>
                  </div>
                ))}
              </dd>
            </div>
          </div>
        </dl>

        <Button href={SITE.maps.directionsUrl} variant="primary" class="mt-8">
          {t('contact.cta')}
          <Icon name="arrow-up-right" class="h-4 w-4" />
        </Button>
      </div>

      <div data-reveal="scale" data-reveal-delay="240" class="lg:col-span-7">
        <div class="relative aspect-[4/3] w-full overflow-hidden rounded-[1.75rem] bg-clay-100 sm:aspect-[16/10] lg:aspect-auto lg:h-full lg:min-h-[26rem]">
          <iframe
            src={SITE.maps.embedUrl}
            title={t('contact.title')}
            class="h-full w-full grayscale-[15%]"
            style="border:0;"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>
    </div>
  </div>
</section>
