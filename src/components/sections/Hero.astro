---
import { Image } from 'astro:assets';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { useTranslations, type Lang } from '@/i18n/utils';
import heroImage from '@/assets/hero/storefront.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const chips = [
  { icon: 'cake' as const, label: t('hero.chip.pasteleria') },
  { icon: 'flower' as const, label: t('hero.chip.flores') },
  { icon: 'sparkle' as const, label: t('hero.chip.espacio') },
];
---

<section id="top" class="relative isolate h-[100svh] min-h-[640px] w-full overflow-hidden bg-ink-900 text-sand-50" data-parallax-scope>
  <div class="absolute inset-0" data-reveal="mask" data-reveal-delay="0">
    <Image
      src={heroImage}
      alt={t('hero.imageLabel')}
      width={1920}
      class="relative h-full w-full scale-[1.12] object-cover object-[center_32%]"
      data-parallax
      data-parallax-speed="0.08"
      data-parallax-zoom="true"
    />
  </div>

  <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink-900 via-ink-900/55 to-ink-900/20"></div>
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-ink-900/55 via-ink-900/10 to-ink-900/40"></div>

  <!-- Chip flotante: pastelería artesanal -->
  <div
    data-reveal="bud"
    data-reveal-delay="700"
    class="pointer-events-none absolute right-6 top-28 z-10 hidden items-center gap-2 rounded-full border border-sand-50/20 bg-ink-900/30 px-4 py-2 text-xs font-medium uppercase tracking-[0.1em] backdrop-blur-sm sm:flex lg:right-12"
  >
    <Icon name={chips[0].icon} class="h-3.5 w-3.5" />
    {chips[0].label}
  </div>

  <!-- Chip flotante: flores seleccionadas -->
  <div
    data-reveal="bud"
    data-reveal-delay="900"
    class="pointer-events-none absolute right-6 top-44 z-10 hidden items-center gap-2 rounded-full border border-sand-50/20 bg-ink-900/30 px-4 py-2 text-xs font-medium uppercase tracking-[0.1em] backdrop-blur-sm sm:flex lg:right-12"
  >
    <Icon name={chips[1].icon} class="h-3.5 w-3.5" />
    {chips[1].label}
  </div>

  <div class="relative z-10 mx-auto flex h-full max-w-[90rem] flex-col justify-end px-5 pb-16 pt-28 sm:pb-20 lg:px-10 lg:pb-24">
    <p
      data-reveal
      data-reveal-delay="0"
      class="text-xs font-semibold uppercase tracking-[0.32em] text-sand-50/70"
    >
      {t('hero.eyebrow')}
    </p>

    <h1
      data-reveal="lg"
      data-reveal-delay="120"
      class="mt-5 max-w-4xl font-display text-[13vw] font-medium leading-[0.98] sm:text-6xl lg:text-7xl xl:text-8xl"
    >
      {t('hero.title')}
    </h1>

    <p
      data-reveal
      data-reveal-delay="360"
      class="mt-7 max-w-md text-base leading-relaxed text-sand-50/80 sm:text-lg"
    >
      {t('hero.subtitle')}
    </p>

    <div data-reveal data-reveal-delay="520" class="mt-10 flex flex-wrap gap-4">
      <Button href="#fusion" variant="primary" class="!bg-sand-50 !text-ink-800 hover:!bg-clay-500 hover:!text-sand-50">
        {t('hero.cta.primary')}
        <Icon name="arrow-right" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" />
      </Button>
      <Button href="#visitanos" variant="ghost" class="!border-sand-50/30 !text-sand-50 hover:!border-sand-50 hover:!bg-sand-50/10">
        {t('hero.cta.secondary')}
      </Button>
    </div>

    <div data-reveal data-reveal-delay="680" class="mt-10 flex flex-wrap gap-x-8 gap-y-3 sm:hidden">
      {chips.map((chip) => (
        <span class="flex items-center gap-2 text-xs font-medium uppercase tracking-[0.08em] text-sand-50/70">
          <Icon name={chip.icon} class="h-3.5 w-3.5" />
          {chip.label}
        </span>
      ))}
    </div>
  </div>

  <div
    data-reveal
    data-reveal-delay="1000"
    class="animate-drift pointer-events-none absolute bottom-8 left-1/2 z-10 hidden -translate-x-1/2 flex-col items-center gap-2 text-sand-50/60 sm:flex"
    style="animation-duration: 6s;"
  >
    <span class="text-[0.65rem] font-medium uppercase tracking-[0.2em]">{t('hero.scrollCue')}</span>
    <span class="h-8 w-px bg-sand-50/40"></span>
  </div>
</section>
