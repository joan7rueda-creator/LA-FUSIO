---
import ImagePlaceholder from '@/components/ui/ImagePlaceholder.astro';
import Icon from '@/components/ui/Icon.astro';

const products = [
  { cat: 'Café', name: 'Café de temporada', tone: 'ink' as const, icon: 'coffee' as const },
  { cat: 'Flores', name: 'Ramo de temporada', tone: 'olive' as const, icon: 'flower' as const },
  { cat: 'Dulces', name: 'Repostería del día', tone: 'sand' as const, icon: 'sparkle' as const },
  { cat: 'Regalos', name: 'Detalle para regalar', tone: 'bloom' as const, icon: 'gift' as const },
  { cat: 'Flores', name: 'Composición floral', tone: 'olive' as const, icon: 'leaf' as const },
  { cat: 'Café', name: 'Selección de grano', tone: 'ink' as const, icon: 'coffee' as const },
];
---

<section id="productos" class="relative overflow-hidden bg-sand-50 py-24 sm:py-32 lg:py-36">
  <div class="mx-auto max-w-[90rem] px-5 lg:px-10">
    <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
      <div class="max-w-xl">
        <p data-reveal class="text-xs font-semibold uppercase tracking-[0.28em] text-olive-700">
          Selección
        </p>
        <h2 data-reveal="lg" data-reveal-delay="80" class="mt-5 font-display text-4xl font-medium leading-[1.05] tracking-tight text-ink-800 sm:text-5xl lg:text-6xl">
          Descubre LAFUSIO
        </h2>
      </div>
      <p data-reveal data-reveal-delay="200" class="max-w-xs text-sm text-ink-700/60">
        Una muestra de lo que encontrarás. Fotografías y nombres definitivos, próximamente.
      </p>
    </div>
  </div>

  <div data-reveal data-reveal-delay="260" class="mt-14 lg:mt-16">
    <div class="no-scrollbar snap-x-mandatory flex gap-5 overflow-x-auto px-5 pb-4 lg:gap-7 lg:px-10">
      {products.map((p) => (
        <div class="group snap-start w-[15.5rem] shrink-0 sm:w-[18rem]">
          <div class="overflow-hidden rounded-[1.25rem]">
            <ImagePlaceholder
              tone={p.tone}
              icon={p.icon}
              label={`${p.cat} — placeholder`}
              class="relative aspect-[4/5] w-full transition-transform duration-500 ease-out group-hover:scale-[1.06]"
            />
          </div>
          <div class="mt-4 flex items-start justify-between gap-3 transition-transform duration-300 ease-out group-hover:-translate-y-1">
            <div>
              <p class="text-[0.65rem] font-semibold uppercase tracking-[0.14em] text-olive-700">{p.cat}</p>
              <h3 class="mt-1 font-display text-lg text-ink-800">{p.name}</h3>
            </div>
            <span class="mt-1 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-ink-800/15 text-ink-800 transition-all duration-300 ease-out group-hover:translate-x-0.5 group-hover:border-ink-800 group-hover:bg-ink-800 group-hover:text-sand-50">
              <Icon name="arrow-up-right" class="h-3.5 w-3.5" />
            </span>
          </div>
        </div>
      ))}
      <div class="shrink-0 basis-1 sm:basis-4" aria-hidden="true"></div>
    </div>
    <p class="mt-2 pl-5 text-xs text-ink-700/40 lg:pl-10">Desliza para ver más →</p>
  </div>
</section>
