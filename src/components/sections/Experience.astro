---
import ImagePlaceholder from '@/components/ui/ImagePlaceholder.astro';
import { useTranslations, type Lang } from '@/i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="relative overflow-hidden bg-clay-50 py-24 sm:py-32 lg:py-40">
  <div class="pointer-events-none absolute inset-0 opacity-[0.35] [background-image:radial-gradient(circle_at_15%_20%,theme(colors.clay.200)_0%,transparent_38%),radial-gradient(circle_at_85%_80%,theme(colors.bloom.100)_0%,transparent_42%)]"></div>

  <div class="relative mx-auto max-w-5xl px-5 lg:px-10">
    <div class="text-center">
      <p data-reveal class="text-xs font-semibold uppercase tracking-[0.28em] text-clay-700">
        {t('experience.eyebrow')}
      </p>
      <h2 data-reveal="lg" data-reveal-delay="80" class="mt-5 font-display text-4xl font-medium text-ink-800 sm:text-5xl lg:text-6xl">
        {t('experience.title')}
      </h2>
    </div>

    <div class="relative mt-16 flex flex-col gap-6 sm:mt-20 sm:gap-4 lg:mt-24">
      <p data-reveal data-reveal-delay="120" class="font-display text-2xl leading-snug text-ink-800/90 sm:text-3xl lg:pl-8 lg:text-4xl">
        {t('experience.line1')}
      </p>
      <p data-reveal data-reveal-delay="260" class="font-display text-2xl leading-snug text-ink-800/90 sm:text-right sm:text-3xl lg:pr-16 lg:text-4xl">
        {t('experience.line2')}
      </p>
      <p data-reveal data-reveal-delay="400" class="font-display text-2xl leading-snug text-clay-700 sm:text-3xl lg:pl-16 lg:text-4xl">
        {t('experience.line3')}
      </p>
    </div>

    <div
      data-reveal="bud"
      data-reveal-delay="500"
      class="pointer-events-none absolute -left-6 top-4 hidden h-28 w-28 -rotate-6 overflow-hidden rounded-[1.25rem] shadow-xl shadow-ink-900/15 lg:block xl:-left-16"
    >
      <ImagePlaceholder lang={lang} tone="bloom" icon="flower" label={t('experience.detailFloral')} compact class="relative h-full w-full" />
    </div>

    <div
      data-reveal="bud"
      data-reveal-delay="650"
      class="pointer-events-none absolute -right-4 bottom-0 hidden h-32 w-32 rotate-6 overflow-hidden rounded-[1.25rem] shadow-xl shadow-ink-900/15 lg:block xl:-right-14"
    >
      <ImagePlaceholder lang={lang} tone="ink" icon="cake" label={t('experience.detailPasteleria')} compact class="relative h-full w-full" />
    </div>
  </div>
</section>
