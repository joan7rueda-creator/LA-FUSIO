---
import ImagePlaceholder from '@/components/ui/ImagePlaceholder.astro';
---

<section class="relative overflow-hidden bg-olive-50 py-24 sm:py-32 lg:py-40">
  <div class="pointer-events-none absolute inset-0 opacity-[0.35] [background-image:radial-gradient(circle_at_15%_20%,theme(colors.olive.200)_0%,transparent_38%),radial-gradient(circle_at_85%_80%,theme(colors.bloom.100)_0%,transparent_42%)]"></div>

  <div class="relative mx-auto max-w-5xl px-5 lg:px-10">
    <div class="text-center">
      <p data-reveal class="text-xs font-semibold uppercase tracking-[0.28em] text-olive-700">
        La experiencia LAFUSIO
      </p>
      <h2 data-reveal="lg" data-reveal-delay="80" class="mt-5 font-display text-4xl font-medium tracking-tight text-ink-800 sm:text-5xl lg:text-6xl">
        No es solo un café.
      </h2>
    </div>

    <div class="relative mt-16 flex flex-col gap-6 sm:mt-20 sm:gap-4 lg:mt-24">
      <p data-reveal data-reveal-delay="120" class="font-display text-2xl italic leading-snug text-ink-800/90 sm:text-3xl lg:pl-8 lg:text-4xl">
        Es ese café que tomas sin mirar el reloj.
      </p>
      <p data-reveal data-reveal-delay="260" class="font-display text-2xl italic leading-snug text-ink-800/90 sm:text-right sm:text-3xl lg:pr-16 lg:text-4xl">
        El ramo que encuentras por casualidad.
      </p>
      <p data-reveal data-reveal-delay="400" class="font-display text-2xl italic leading-snug text-olive-700 sm:text-3xl lg:pl-16 lg:text-4xl">
        El lugar al que entras por una cosa y terminas descubriendo otra.
      </p>
    </div>

    <div
      data-reveal="bud"
      data-reveal-delay="500"
      class="pointer-events-none absolute -left-6 top-4 hidden h-28 w-28 -rotate-6 overflow-hidden rounded-[1.25rem] shadow-xl shadow-ink-900/15 lg:block xl:-left-16"
    >
      <ImagePlaceholder tone="bloom" icon="flower" label="Detalle floral" compact class="relative h-full w-full" />
    </div>

    <div
      data-reveal="bud"
      data-reveal-delay="650"
      class="pointer-events-none absolute -right-4 bottom-0 hidden h-32 w-32 rotate-6 overflow-hidden rounded-[1.25rem] shadow-xl shadow-ink-900/15 lg:block xl:-right-14"
    >
      <ImagePlaceholder tone="ink" icon="coffee" label="Detalle de café" compact class="relative h-full w-full" />
    </div>
  </div>
</section>
